# Web App 环境变量配置

# 服务端口
PORT=39112

# Neo4j 配置
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=niuniuniu
NEO4J_DATABASE=neo4j

# 通知配置
ENABLE_WEBHOOK_NOTIFICATION=true
WEBHOOK_URL=

# 调度器配置
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_ENABLE_HIGH_LEVEL_SCAN=true
SCHEDULER_ENABLE_HOURLY_SUMMARY=true
SCHEDULER_ENABLE_DAILY_SUMMARY=true

# 高级别新闻扫描配置
HIGH_LEVEL_SCAN_CRON=*/5 * * * *
HIGH_LEVEL_SCAN_LEVELS=1,2

# 总结配置
HOURLY_SUMMARY_CRON=0 11-22 * * *
DAILY_SUMMARY_CRON=0 10 * * *

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/web-app.log

# 外部服务配置
INGEST_WORKER_URL=http://ingest-worker:39110
GRAPH_WORKER_URL=http://graph-worker:39111 