# Web App 环境变量配置

# 服务端口
PORT=39112

# Neo4j 配置
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=niuniuniu
NEO4J_DATABASE=neo4j

# AI 配置
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-reasoner
