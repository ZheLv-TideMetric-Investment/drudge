{
  "name": "@drudge/graph-worker",
  "version": "1.0.0",
  "description": "新闻知识图谱处理工作器",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon",
    "start": "node dist/index.js",
    "cli": "node dist/cli-entry.js",
    "test": "jest",
    "test:ci": "jest --coverage --runInBand",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "clean": "rm -rf dist logs server.log",
    "setup-db": "npm run cli setup-db",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs graph-worker",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@drudge/common": "workspace:*",
    "@ai-sdk/deepseek": "^0.2.14",
    "@ai-sdk/google": "^1.2.19",
    "@ai-sdk/openai": "^1.3.23",
    "@ai-sdk/xai": "^1.2.18",
    "@types/express": "^5.0.3",
    "@types/node-cron": "^3.0.11",
    "ai": "^4.3.16",
    "axios": "^1.6.7",
    "chrono-node": "^2.8.3",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "neo4j-driver": "^5.28.1",
    "node-cron": "^3.0.3",
    "ts-enum-util": "^4.1.0",
    "winston": "^3.11.0",
    "zod": "^3.25.72"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.12",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "pm2": "^5.3.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "private": true
}
