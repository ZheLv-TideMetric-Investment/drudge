# 基础服务配置
PORT=39111
NODE_ENV=production

# Neo4j 数据库配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=niuniuniu
NEO4J_DATABASE=neo4j

# AI 配置
AI_PROVIDER=qwen
AI_FALLBACK_PROVIDER=xai
# DeepSeek 配置
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
# Google 配置
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash
# 千问配置
QWEN_API_KEY=
QWEN_MODEL=qwen-turbo
# xAI 配置
XAI_API_KEY=
XAI_MODEL=grok-3-mini
XAI_PROXY_URL=

# 数据源配置
NEWS_DIRECTORY=../../data/news

# 基础处理配置
BATCH_SIZE=10
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# 内存优化配置 - 重要！根据服务器配置调整
# 实体提取分块大小（每次处理多少条新闻）
# 建议值：服务器内存2GB=20, 4GB=40, 8GB=80
EXTRACTION_CHUNK_SIZE=20

# 新闻处理分块大小（总体批量处理分块）
# 建议值：服务器内存2GB=50, 4GB=100, 8GB=200
PROCESSING_CHUNK_SIZE=50

# AI调用批次大小（并行调用AI的数量）
# 建议值：2-5，避免过高导致API限制
AI_BATCH_SIZE=3

# 内存警告阈值（百分比 0.0-1.0）
# 建议值：0.7（70%时开始警告）
MEMORY_WARNING_THRESHOLD=0.7

# 内存危险阈值（百分比 0.0-1.0）  
# 建议值：0.85（85%时强制垃圾回收）
MEMORY_DANGER_THRESHOLD=0.85

# 最大堆内存大小（MB）
# 必须与ecosystem.config.js中的max-old-space-size保持一致
MAX_HEAP_SIZE_MB=2048

# 内存监控间隔（毫秒）
# 建议值：30000（30秒检查一次）
MEMORY_MONITORING_INTERVAL_MS=30000

# 分块间延迟（毫秒）
# 建议值：1000-3000，给系统喘息时间
CHUNK_DELAY_MS=1000

# 自动垃圾回收（true/false）
# 建议值：true（启用自动垃圾回收）
ENABLE_AUTO_GC=true

# 通知配置
ENABLE_WEBHOOK_NOTIFICATION=false
WEBHOOK_URL=

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=combined

# 数据库管理配置
# NODE_ENV=development  # 开发环境
# BACKUP_DIR=./backup   # 备份目录 