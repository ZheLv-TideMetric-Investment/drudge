# 处理配置
BATCH_SIZE=10
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# Webhook通知配置
ENABLE_WEBHOOK_NOTIFICATION=true
WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=1d6343ebed2e04f89aec410bd47714b06ba5ffb77c0fbede0ed1e3644091795f

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=combined

