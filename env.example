# Drudge Monorepo unified environment variables
#
# Usage:
#   cp env.example .env
#
# All packages load this root .env by default.

# ===== Runtime =====
NODE_ENV=development

# ===== Service Ports =====
WEB_APP_PORT=39112
INGEST_WORKER_PORT=39110
GRAPH_WORKER_PORT=39111

# ===== Neo4j (web-app + graph-worker) =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ===== AI Providers (web-app + graph-worker) =====
AI_PROVIDER=qwen
AI_FALLBACK_PROVIDER=xai
SIMPLE_AI_PROVIDER=qwen

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-reasoner

GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-1.5-flash

QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=qwen-turbo

XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-3-mini
XAI_PROXY_URL=

JINA_API_KEY=your-jina-api-key

# ===== SEC (web-app optional) =====
SEC_API_MAIL=
SEC_API_COMPANY=

# ===== ingest-worker =====
STORAGE_PATH=/absolute/path/to/drudge/data
NEWS_API_URL=https://news.futunn.com/news-site-api/main/get-flash-list
NEWS_API_PAGE_SIZE=50
NEWS_API_REQUEST_INTERVAL=1000

# ===== graph-worker data source =====
NEWS_DIRECTORY=/absolute/path/to/drudge/data/news
FAILED_NEWS_DIRECTORY=/absolute/path/to/drudge/data/news/failed

# ===== graph-worker processing =====
BATCH_SIZE=10
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
EXTRACTION_CHUNK_SIZE=20
PROCESSING_CHUNK_SIZE=50
AI_BATCH_SIZE=3
MEMORY_WARNING_THRESHOLD=0.7
MEMORY_DANGER_THRESHOLD=0.85
MAX_HEAP_SIZE_MB=2048
MEMORY_MONITORING_INTERVAL_MS=30000
CHUNK_DELAY_MS=1000
ENABLE_AUTO_GC=true

# ===== Notifications =====
ENABLE_WEBHOOK_NOTIFICATION=false
WEBHOOK_URL=
WEBHOOK_URLS=

# ===== web-app scheduler =====
CRON_HIGH_LEVEL_SCAN=0 */5 * * * *
CRON_HOURLY_SUMMARY=0 0 11-22 * * *
CRON_DAILY_SUMMARY=0 0 10 * * *

# ===== Logging =====
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_FORMAT=combined
