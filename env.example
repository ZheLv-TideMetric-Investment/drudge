# Drudge Monorepo unified environment variables
#
# Usage:
#   cp env.example .env
#
# All packages load this root .env by default.

# ===== Runtime =====
NODE_ENV=development

# ===== Service Ports =====
WEB_APP_PORT=39112
INGEST_WORKER_PORT=39110
GRAPH_WORKER_PORT=39111

# ===== Neo4j (web-app + graph-worker) =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ===== AI Providers (web-app + graph-worker) =====
AI_PROVIDER=qwen
AI_FALLBACK_PROVIDER=xai
SIMPLE_AI_PROVIDER=qwen

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-2.5-flash-lite

QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=qwen3.7-flash

XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-4.3
XAI_PROXY_URL=

JINA_API_KEY=your-jina-api-key

# ===== SEC (web-app optional) =====
SEC_API_MAIL=
SEC_API_COMPANY=

# ===== ingest-worker =====
STORAGE_PATH=/absolute/path/to/drudge/data
NEWS_API_URL=https://news.futunn.com/news-site-api/main/get-flash-list
NEWS_API_PAGE_SIZE=50
NEWS_API_REQUEST_INTERVAL=1000

# ===== graph-worker data source =====
NEWS_DIRECTORY=/absolute/path/to/drudge/data/news
FAILED_NEWS_DIRECTORY=/absolute/path/to/drudge/data/news/failed

# ===== graph-worker processing =====
BATCH_SIZE=10
GRAPH_MAX_FILES_PER_SCAN=200
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
EXTRACTION_CHUNK_SIZE=20
PROCESSING_CHUNK_SIZE=50
AI_BATCH_SIZE=3
MEMORY_WARNING_THRESHOLD=0.7
MEMORY_DANGER_THRESHOLD=0.85
MAX_HEAP_SIZE_MB=2048
MEMORY_MONITORING_INTERVAL_MS=30000
CHUNK_DELAY_MS=1000
ENABLE_AUTO_GC=true

# ===== Notifications =====
# ingest-worker / graph-worker 异常预警（自定义 Webhook，单链接）
ENABLE_WEBHOOK_NOTIFICATION=false
ALERT_WEBHOOK_URL=

# web-app 主动推送（复用企业机器人，只投放到显式指定用户的单聊；空值不发送）
ENABLE_DINGTALK_NOTIFICATION=false
DINGTALK_APP_CLIENT_ID=your-dingtalk-app-client-id
DINGTALK_APP_CLIENT_SECRET=your-dingtalk-app-client-secret
DINGTALK_TARGET_USER_ID=explicit-recipient-user-id
BRIEFING_PUBLIC_BASE_URL=https://news.example.com
BRIEFING_STORAGE_PATH=/absolute/path/to/drudge/data/briefings

# ===== web-app scheduler =====
CRON_HIGH_LEVEL_SCAN=0 */5 * * * *
CRON_HOURLY_SUMMARY=0 0 11-22 * * *
CRON_DAILY_SUMMARY=0 0 10 * * *

# ===== Logging =====
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_FORMAT=combined
