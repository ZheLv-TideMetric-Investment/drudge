{
  "name": "drudge",
  "version": "1.0.0",
  "description": "新闻聚合和AI总结服务",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/fix-imports.cjs",
    "build:workers": "node scripts/build-workers.cjs",
    "start": "node dist/index.js",
    "dev": "node scripts/dev.cjs",
    "dev:simple": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" --config .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" --config .prettierrc.json",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --fix",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs drudge",
    "pm2:status": "pm2 status",
    "news": "node dist/interfaces/cli/newsAcquisition.js",
    "graph": "node dist/interfaces/cli/knowledgeGraph.js",
    "level": "node dist/interfaces/cli/newsLevelCheck.js",
    "health": "node dist/interfaces/cli/systemHealth.js",
    "news:dev": "tsx src/interfaces/cli/newsAcquisition.ts",
    "graph:dev": "tsx src/interfaces/cli/knowledgeGraph.ts",
    "level:dev": "tsx src/interfaces/cli/newsLevelCheck.ts",
    "health:dev": "tsx src/interfaces/cli/systemHealth.ts",
    "schema:apply": "cypher-shell -f neo4j/schema.cypher",
    "clean:neo4j": "node scripts/cleanNeo4j.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/deepseek": "^0.2.14",
    "@ai-sdk/google": "^1.2.19",
    "ai": "^4.3.16",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "neo4j-driver": "^5.28.1",
    "node-cron": "^3.0.3",
    "pm2": "^5.3.1",
    "winston": "^3.11.0",
    "zod": "^3.25.72"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/moment-timezone": "^0.5.30",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
