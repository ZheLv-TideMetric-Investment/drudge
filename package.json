{
  "name": "drudge-monorepo",
  "version": "1.0.0",
  "description": "实时财经新闻采集、AI 结构化总结与钉钉推送系统",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --parallel -r run start",
    "test": "pnpm -r run test --runInBand --silent",
    "lint": "pnpm -r run lint",
    "lint:env": "bash scripts/check-env-usage.sh",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "briefing:test-live": "tsx packages/web-app/src/scripts/send-briefing-test.ts",
    "verify": "pnpm run lint:env && pnpm run format:check && pnpm run lint && pnpm run test && pnpm run build",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0"
  },
  "author": "",
  "license": "ISC",
  "workspaces": [
    "packages/*",
    "shared/*"
  ]
}
