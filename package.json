{
  "name": "drudge",
  "version": "1.0.0",
  "description": "新闻聚合和AI总结服务",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{js,json}\" --config .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{js,json}\" --config .prettierrc.json",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs drudge",
    "pm2:status": "pm2 status",
    
    "news": "node src/scripts/newsAcquisition.js",
    "graph": "node src/scripts/knowledgeGraph.js",
    "level": "node src/scripts/newsLevelCheck.js",
    "health": "node src/scripts/systemHealth.js",
    
    "schema:apply": "cypher-shell -f neo4j/schema.cypher",
    "clean:neo4j": "node scripts/cleanNeo4j.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/deepseek": "^0.2.14",
    "@ai-sdk/google": "^1.2.19",
    "ai": "^4.3.16",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "neo4j-driver": "^5.28.1",
    "node-cron": "^3.0.3",
    "pm2": "^5.3.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5"
  }
}
